# SATyS portable — copiar a .env y ajustar sólo lo necesario.
SATYS_API_PORT=8082
SATYS_API_BIND=127.0.0.1
SATYS_API_NETWORK=slirp4netns:enable_ipv6=false
SATYS_TZ=America/Mexico_City
SATYS_RUNTIME_DIR=./runtime
SATYS_SHARED_HOST_DIR=./runtime/shared
SATYS_LOCK_HOST_DIR=./runtime/locks
SATYS_CONFIG_HOST_FILE=./config/configuracion_local.json
SATYS_IMAGE=satys-api:2026.08.17-portable-oci-api-v1-8082-ui2
SATYS_GIT_COMMIT=unknown

# En Linux con Docker Compose, scripts/bootstrap_portable.sh actualiza estos dos.
SATYS_UID=10001
SATYS_GID=10001

# Dentro del contenedor la carpeta compartida siempre se ve como /shared.
SATYS_SHARED_DIR=/shared
SATYS_REQUIRE_SHARED_MOUNT=0

# Opcionales: permiten no guardar credenciales en JSON.
# SATYS_USUARIO=
# SATYS_PASSWORD=
# SATYS_EMAIL_REMITENTE=
# SATYS_EMAIL_APP_PASSWORD=
# SATYS_EMAIL_ENABLED=0
