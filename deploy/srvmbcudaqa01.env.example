# Perfil del servidor observado el 2026-08-17. No contiene credenciales.
# Copiar a .env en la carpeta de la release nueva.
SATYS_API_PORT=8082
SATYS_TZ=America/Mexico_City
SATYS_IMAGE=satys-api:2026.08.17-portable-oci-api-v1-8082
SATYS_GIT_COMMIT=unknown

# Reutiliza el runtime productivo existente SIN copiar ~7 GB de datos.
SATYS_RUNTIME_DIR=/data/gustavo.garcia/satys/Automatizacion-SATyS
SATYS_CONFIG_HOST_FILE=/data/gustavo.garcia/satys/Automatizacion-SATyS/config/configuracion_local.json
SATYS_SHARED_HOST_DIR=/depi/dgp/DEI_DATOS/SATyS
SATYS_LOCK_HOST_DIR=/data/gustavo.garcia/satys/.lock

# Las rutas dentro del contenedor son estables y no dependen del host.
SATYS_SHARED_DIR=/shared
SATYS_REQUIRE_SHARED_MOUNT=0
