# Ejemplo de producción genérico. No contiene secretos.
SATYS_API_PORT=8082
SATYS_API_BIND=127.0.0.1
SATYS_API_NETWORK=slirp4netns:enable_ipv6=false
SATYS_TZ=America/Mexico_City
SATYS_INTERNOS_WORKERS=12
SATYS_INTERNOS_WORKER_REINTENTOS=2
SATYS_INTERNOS_WORKER_ESPERA=2
SATYS_ZIP_MAX_ITERACIONES=32
SATYS_ZIP_RUTA_RELATIVA_MAX=140
SATYS_SHM_SIZE=6gb
SATYS_RUNTIME_DIR=/opt/satys/runtime
SATYS_SHARED_HOST_DIR=/opt/satys/shared
SATYS_LOCK_HOST_DIR=/opt/satys/locks
SATYS_CONFIG_HOST_FILE=/etc/satys/configuracion_local.json
SATYS_IMAGE=satys-api:2026.08.20-portable-oci-api-v1-8082-internos-audit1
SATYS_SHARED_DIR=/shared
SATYS_REQUIRE_SHARED_MOUNT=0
