[Unit]
Description=SATyS CRT - Revisión diaria de registros nuevos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gustavo.garcia
WorkingDirectory=/data/satys/Automatizacion-SATyS
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=SATYS_PYTHON=/data/satys/venv/bin/python
Environment=SATYS_LOCK_DIR=/data/satys/Automatizacion-SATyS/.lock
ExecStart=/data/satys/Automatizacion-SATyS/scripts/run_satys_diario.sh
